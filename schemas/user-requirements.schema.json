{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skin-ai:schema:user-requirements:v1",
  "title": "Skin AI normalized user requirements",
  "description": "The validated functional clothing requirements produced after interpreting a user's request. These fields describe what the user asks for; they never infer requirements from a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "garmentTypes",
    "requiredAccess",
    "excludedAccess",
    "preferredAccess",
    "requiredMeasurements"
  ],
  "properties": {
    "garmentTypes": {
      "description": "The garment categories requested by the user.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/garmentType"
      }
    },
    "occasion": {
      "description": "An optional normalized occasion used for catalogue filtering or ranking.",
      "type": "string",
      "enum": [
        "casual",
        "work",
        "formal",
        "wedding_guest",
        "travel",
        "exercise",
        "sleepwear",
        "unknown"
      ]
    },
    "requiredAccess": {
      "description": "Hard functional requirements. A product can pass only when its corresponding facts are confirmed and compatible.",
      "$ref": "#/$defs/accessRequirements"
    },
    "excludedAccess": {
      "description": "Garment facts the user identifies as inaccessible or unsuitable.",
      "$ref": "#/$defs/accessRequirements"
    },
    "preferredAccess": {
      "description": "Preferences that may rank products but cannot override a hard conflict.",
      "$ref": "#/$defs/accessRequirements"
    },
    "requiredMeasurements": {
      "description": "Optional garment measurement ranges requested by the user, expressed in centimetres.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/measurementRequirement"
      }
    }
  },
  "$defs": {
    "garmentType": {
      "type": "string",
      "enum": [
        "top",
        "shirt",
        "blouse",
        "dress",
        "jumpsuit",
        "trousers",
        "jeans",
        "skirt",
        "shorts",
        "jacket",
        "coat",
        "cardigan",
        "jumper",
        "outfit",
        "unknown"
      ]
    },
    "closureType": {
      "type": "string",
      "enum": [
        "none",
        "zip",
        "buttons",
        "snaps",
        "magnetic",
        "hook_and_loop",
        "wrap_tie",
        "drawstring",
        "buckle",
        "hook_and_bar"
      ]
    },
    "closureLocation": {
      "type": "string",
      "enum": [
        "front",
        "side",
        "back",
        "shoulder",
        "inseam",
        "multiple"
      ]
    },
    "dressingMethod": {
      "type": "string",
      "enum": [
        "full_front_opening",
        "partial_front_opening",
        "overhead",
        "step_in",
        "wrap"
      ]
    },
    "gripFeature": {
      "type": "string",
      "enum": [
        "ring_pull",
        "loop_pull",
        "extended_tab",
        "large_documented",
        "none_documented"
      ]
    },
    "openingExtent": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "accessRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closureType": {
          "$ref": "#/$defs/uniqueClosureTypes"
        },
        "closureLocation": {
          "$ref": "#/$defs/uniqueClosureLocations"
        },
        "dressingMethod": {
          "$ref": "#/$defs/uniqueDressingMethods"
        },
        "gripFeature": {
          "$ref": "#/$defs/uniqueGripFeatures"
        },
        "openingExtent": {
          "$ref": "#/$defs/uniqueOpeningExtents"
        }
      }
    },
    "uniqueClosureTypes": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/closureType"
      }
    },
    "uniqueClosureLocations": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/closureLocation"
      }
    },
    "uniqueDressingMethods": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dressingMethod"
      }
    },
    "uniqueGripFeatures": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gripFeature"
      }
    },
    "uniqueOpeningExtents": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/openingExtent"
      }
    },
    "measurementRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "chest",
            "waist",
            "hip",
            "shoulder_width",
            "sleeve_length",
            "garment_length",
            "inside_leg",
            "front_rise",
            "back_rise"
          ]
        },
        "minimumCm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        },
        "maximumCm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        }
      },
      "anyOf": [
        {
          "required": [
            "minimumCm"
          ]
        },
        {
          "required": [
            "maximumCm"
          ]
        }
      ]
    }
  }
}
