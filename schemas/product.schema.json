{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skin-ai:schema:product:v1",
  "title": "Skin AI catalogue product",
  "description": "A grounded retailer product normalized for deterministic clothing matching. Accessibility-related fields record garment facts and their evidence, not universal suitability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "retailer",
    "productUrl",
    "imageUrls",
    "virtualTryOn",
    "garmentType",
    "sizes",
    "measurements",
    "access"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "retailer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "productUrl": {
      "type": "string",
      "format": "uri"
    },
    "imageUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "virtualTryOn": {
      "description": "Trusted provider configuration for virtual try-on. Ready products reference a verified image from imageUrls; unavailable products cannot be submitted.",
      "oneOf": [
        {
          "$ref": "#/$defs/readyVirtualTryOn"
        },
        {
          "$ref": "#/$defs/unavailableVirtualTryOn"
        }
      ]
    },
    "garmentType": {
      "$ref": "#/$defs/garmentType"
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "availability": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "unknown"
      ]
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closureType",
        "closureLocation",
        "dressingMethod",
        "gripFeature",
        "openingExtent"
      ],
      "properties": {
        "closureType": {
          "$ref": "#/$defs/closureTypeEvidence"
        },
        "closureLocation": {
          "$ref": "#/$defs/closureLocationEvidence"
        },
        "dressingMethod": {
          "$ref": "#/$defs/dressingMethodEvidence"
        },
        "gripFeature": {
          "$ref": "#/$defs/gripFeatureEvidence"
        },
        "openingExtent": {
          "$ref": "#/$defs/openingExtentEvidence"
        }
      }
    }
  },
  "$defs": {
    "readyVirtualTryOn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "referenceImageIndex",
        "garmentCategory"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "provider": {
          "const": "youcam_clothes_v3"
        },
        "referenceImageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "garmentCategory": {
          "description": "The currently verified YouCam Clothes v3 category for the MVP dress reference.",
          "const": "full_body"
        }
      }
    },
    "unavailableVirtualTryOn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        }
      }
    },
    "garmentType": {
      "type": "string",
      "enum": [
        "top",
        "shirt",
        "blouse",
        "dress",
        "jumpsuit",
        "trousers",
        "jeans",
        "skirt",
        "shorts",
        "jacket",
        "coat",
        "cardigan",
        "jumper",
        "outfit",
        "unknown"
      ]
    },
    "evidenceStatus": {
      "type": "string",
      "enum": [
        "retailer_provided",
        "manually_verified",
        "unknown"
      ]
    },
    "closureTypeEvidence": {
      "type": "object",
      "$ref": "#/$defs/evidenceObject",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "none",
            "zip",
            "buttons",
            "snaps",
            "magnetic",
            "hook_and_loop",
            "wrap_tie",
            "drawstring",
            "buckle",
            "hook_and_bar",
            "unknown"
          ]
        }
      }
    },
    "closureLocationEvidence": {
      "type": "object",
      "$ref": "#/$defs/evidenceObject",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "front",
            "side",
            "back",
            "shoulder",
            "inseam",
            "multiple",
            "unknown"
          ]
        }
      }
    },
    "dressingMethodEvidence": {
      "type": "object",
      "$ref": "#/$defs/evidenceObject",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "full_front_opening",
            "partial_front_opening",
            "overhead",
            "step_in",
            "wrap",
            "unknown"
          ]
        }
      }
    },
    "gripFeatureEvidence": {
      "type": "object",
      "$ref": "#/$defs/evidenceObject",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "ring_pull",
            "loop_pull",
            "extended_tab",
            "large_documented",
            "none_documented",
            "unknown"
          ]
        }
      }
    },
    "openingExtentEvidence": {
      "type": "object",
      "$ref": "#/$defs/evidenceObject",
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "unknown"
          ]
        }
      }
    },
    "evidenceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": "unknown"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "not": {
                  "const": "unknown"
                }
              }
            },
            "required": [
              "sourceText",
              "sourceUrl"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "manually_verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verifiedAt"
            ]
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "name",
        "valueCm",
        "status",
        "sourceUrl"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "name": {
          "type": "string",
          "enum": [
            "chest",
            "waist",
            "hip",
            "shoulder_width",
            "sleeve_length",
            "garment_length",
            "inside_leg",
            "front_rise",
            "back_rise"
          ]
        },
        "valueCm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        },
        "status": {
          "type": "string",
          "enum": [
            "retailer_provided",
            "manually_verified"
          ]
        },
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "manually_verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "verifiedAt"
        ]
      }
    }
  }
}
