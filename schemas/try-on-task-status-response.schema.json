{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skin-ai:schema:try-on-task-status-response:v1",
  "title": "Skin AI virtual try-on task status response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "status",
    "resultUrl",
    "error"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "succeeded",
        "failed"
      ]
    },
    "resultUrl": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "processing"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resultUrl": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resultUrl": {
            "type": "string",
            "format": "uri"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resultUrl": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
